# Town Crier settings. On the Yoga laptop these live in
# /etc/tavernworks/towncrier.env (bot-host/setup.sh creates it from this).

# A Twitch app of its own (dev.twitch.tv/console), with this OAuth redirect:
#   https://crier.tavernworks.dev/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Long random strings: openssl rand -hex 32
ADMIN_KEY=
EVENTSUB_SECRET=
# More operators besides stonedsheamus (comma-separated Twitch logins)
# ADMIN_TWITCH_LOGINS=

PUBLIC_BASE_URL=https://crier.tavernworks.dev

# WORDS=off disables the private helper (words.ts).

# The Grand Orrery: the bot's personality (name, role, line) is read from
# its record there, like the other bots. All optional; see orrery.ts.
# ORRERY=off
# ORRERY_BRANCH=main
# ORRERY_REFRESH_MIN=30
# ORRERY_BOT_PERSON=the-town-crier
# ORRERY_GITHUB_TOKEN=
# Contact link on /privacy and /terms
SUPPORT_URL=https://tavernworks.dev/
PORT=8804
DB_PATH=./data/towncrier.sqlite
